# Example environment variables for BackendAPIService (do not commit real secrets)
PGAPI_BASE=/api
PGBACKEND_URL=http://localhost:8000
PGFRONTEND_URL=http://localhost:3000
PGWS_URL=
PGNODE_ENV=development
PGENABLE_SOURCE_MAPS=true
PGPORT=8000
PGTRUST_PROXY=false
PGLOG_LEVEL=INFO
PGHEALTHCHECK_PATH=/
PGFEATURE_FLAGS=
PGEXPERIMENTS_ENABLED=false

# Database
# For Postgres: DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname
# For local dev (default falls back to sqlite file):
DATABASE_URL=sqlite:///./ekyc.db

# Security
JWT_SECRET_KEY=please-set-a-strong-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Storage
STORAGE_DIR=./storage
AUDIT_LOG_FILE=./storage/audit.log
